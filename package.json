{
  "name": "occasions",
  "description": "Tags your HTML’s body element with a class and data attribute reflecting today’s occasion or holiday. Framework-agnostic, with an optional Vue plugin.",
  "private": false,
  "version": "3.0.0",
  "keywords": [
    "dates",
    "holidays",
    "occasions",
    "vue",
    "react",
    "svelte"
  ],
  "type": "module",
  "main": "./dist/occasions.cjs",
  "module": "./dist/occasions.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/occasions.iife.js",
  "jsdelivr": "./dist/occasions.iife.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/occasions.js",
      "require": "./dist/occasions.cjs"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./presets": {
      "types": "./types/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./occasions.json": "./src/occasions.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "src/occasions.json"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode iife",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speasley/occasions.git"
  },
  "author": "Stephen Peasley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/speasley/occasions/issues"
  },
  "homepage": "https://github.com/speasley/occasions/#readme",
  "devDependencies": {
    "@vitest/coverage-istanbul": "^0.29.8",
    "vite": "^4.2.0",
    "vitest": "^0.29.8"
  }
}
